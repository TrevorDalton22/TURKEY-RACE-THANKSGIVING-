{
  "name": "turkey-race",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "Gobble": { "$className": "RemoteEvent" },
        "Knockback": { "$className": "RemoteEvent" },
        "Notify": { "$className": "RemoteEvent" },
        "Results": { "$className": "RemoteEvent" },
        "Settings": { "$className": "RemoteEvent" },
        "Shop": { "$className": "RemoteFunction" },
        "Sound": { "$className": "RemoteEvent" },
        "UsePowerUp": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
